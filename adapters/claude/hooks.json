{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.unify-notifier/bin/unify-notifier --agent claude --event completed --stdin"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.unify-notifier/bin/unify-notifier --agent claude --event failed --stdin"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.unify-notifier/bin/unify-notifier --agent claude --event approval --stdin"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.unify-notifier/bin/unify-notifier --agent claude --event input-required --stdin"
          }
        ]
      }
    ]
  }
}
