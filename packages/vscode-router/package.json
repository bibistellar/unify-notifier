{
  "name": "unify-notifier-router",
  "displayName": "Unify Notifier Router",
  "description": "Workspace-side bridge for forwarding AI agent hook events to the local Unify Notifier UI extension.",
  "version": "0.1.0",
  "publisher": "bibistellar",
  "license": "MIT",
  "engines": {"vscode": "^1.105.0"},
  "categories": ["Other"],
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "extensionDependencies": ["bibistellar.unify-notifier-ui"],
  "contributes": {"commands": [{"command": "unifyNotifier.router.status", "title": "Unify Notifier: Show Router Status"}]},
  "scripts": {"build": "tsc -p tsconfig.json", "clean": "rm -rf dist"},
  "dependencies": {"@unify-notifier/protocol": "0.1.0"},
  "devDependencies": {"@types/node": "^22.0.0", "@types/vscode": "^1.105.0", "typescript": "^5.9.0"}
}
