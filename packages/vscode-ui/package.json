{
  "name": "unify-notifier-ui",
  "displayName": "Unify Notifier UI",
  "description": "Local UI endpoint for Unify Notifier. Delivers native desktop notifications from local and remote coding agents.",
  "version": "0.1.0",
  "publisher": "bibistellar",
  "license": "MIT",
  "engines": {"vscode": "^1.105.0"},
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "main": "./dist/extension.js",
  "activationEvents": ["onCommand:unifyNotifier.ui.notify", "onCommand:unifyNotifier.testNotification"],
  "contributes": {
    "commands": [{"command":"unifyNotifier.testNotification","title":"Unify Notifier: Test Desktop Notification"}],
    "configuration": {"title":"Unify Notifier","properties":{
      "unifyNotifier.nativeNotifications":{"type":"boolean","default":true,"description":"Show native operating-system notifications."},
      "unifyNotifier.vscodeToasts":{"type":"boolean","default":false,"description":"Also show notifications inside VS Code."},
      "unifyNotifier.notifyWhenFocused":{"type":"boolean","default":false,"description":"Show native notifications even when VS Code is focused."}
    }}
  },
  "scripts": {"build":"tsc -p tsconfig.json","clean":"rm -rf dist"},
  "dependencies": {"@unify-notifier/protocol":"0.1.0","node-notifier":"^10.0.1"},
  "devDependencies": {"@types/node":"^22.0.0","@types/vscode":"^1.105.0","typescript":"^5.9.0"}
}
